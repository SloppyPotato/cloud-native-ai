# Kopiert diese Datei nach .env und tragt eure Werte ein.
# .env kommt NIE ins Repository (steht in .gitignore).

# Variante A: lokales Modell über Ollama (läuft im Container "ollama")
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2:3b
# Zum Vergleich: LLM_MODEL=qwen2.5:3b
LLM_API_KEY=nicht-noetig

# Variante B: Academic Cloud (GWDG). Key über KISSKI beantragen.
# Das Modell muss Tool Calling unterstützen, qwen3-30b-a3b-instruct-2507 kann das.
# LLM_BASE_URL=https://chat-ai.academiccloud.de/v1
# LLM_MODEL=qwen3-30b-a3b-instruct-2507
# LLM_API_KEY=euer-key

# Adresse des MCP-Servers im Compose-Netz
MCP_URL=http://campus-mcp:8000/mcp

# Feste Uhr für reproduzierbare Messungen: Das Werkzeug heute() liefert
# dieses Datum statt des echten. Leer lassen für das echte Datum.
HEUTE=2026-11-03
